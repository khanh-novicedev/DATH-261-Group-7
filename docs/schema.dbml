// Class2Life — merged schema (Group 7)
// Conventions: UUID PKs, snake_case plural names, inline refs, created_at + updated_at.
// Docs: https://dbml.dbdiagram.io/docs

Project Class2Life {
  database_type: 'PostgreSQL'
  Note: 'The overview for the physical ERD - Group 7'
}

// ==========================================
// ENUMS
// ==========================================
Enum user_role {
  ADMIN
  INSTRUCTOR
  LEARNER
}

Enum user_status {
  ACTIVE
  SUSPENDED
}

Enum course_status {
  DRAFT
  PUBLISHED
  HIDDEN
}

Enum lesson_type {
  VIDEO
  TEXT
  LIVE_PRACTICE
}

Enum completion_status {
  IN_PROGRESS
  COMPLETED
}

Enum assignment_type {
  QUIZ
  FILE_SUBMISSION
}

Enum report_status {
  PENDING
  RESOLVED
  DISMISSED
}

Enum notification_type {
  NEW_CONTENT
  DEADLINE
  SYSTEM
}

Enum session_status {
  SCHEDULED
  ONGOING
  COMPLETED
}

Enum participation_level {
  LOW
  MEDIUM
  HIGH
}

// ==========================================
// ACCOUNTS & ADMIN
// ==========================================
Table app_users {
  id uuid [pk, default: `uuid_generate_v4()`]
  full_name varchar [not null]
  email varchar [unique, not null]
  password_hash varchar [not null]
  role user_role [not null, default: 'LEARNER']
  status user_status [not null, default: 'ACTIVE', note: 'Can be suspended by Admin']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp
}

Table password_resets {
  id uuid [pk, default: `uuid_generate_v4()`]
  user_id uuid [not null, ref: > app_users.id]
  token_hash varchar [not null]
  expire_at timestamp [not null]
  used_at timestamp
  created_at timestamp [not null, default: `now()`]
}

Table admin_audit_logs {
  id uuid [pk, default: `uuid_generate_v4()`]
  actor_id uuid [not null, ref: > app_users.id, note: 'Admin who performed the action']
  action varchar [not null, note: 'e.g., SUSPEND_USER, RESOLVE_REPORT']
  entity_type varchar [note: 'Table name affected']
  entity_id uuid [note: 'ID of the affected record']
  created_at timestamp [not null, default: `now()`]
}

// ==========================================
// COURSES & CONTENT
// ==========================================
Table courses {
  id uuid [pk, default: `uuid_generate_v4()`]
  instructor_id uuid [not null, ref: > app_users.id]
  title varchar [not null]
  description text
  category varchar
  status course_status [not null, default: 'DRAFT']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp
}

Table lessons {
  id uuid [pk, default: `uuid_generate_v4()`]
  course_id uuid [not null, ref: > courses.id]
  sequence_number int [not null]
  title varchar [not null]
  type lesson_type [not null]
  content_url varchar [note: 'URL to MinIO or S3']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp

  indexes {
    (course_id, sequence_number) [unique]
  }
}

// ==========================================
// ENROLMENT & PROGRESS
// ==========================================
Table enrolments {
  id uuid [pk, default: `uuid_generate_v4()`]
  user_id uuid [not null, ref: > app_users.id]
  course_id uuid [not null, ref: > courses.id]
  completion_status completion_status [not null, default: 'IN_PROGRESS']
  last_position_lesson_id uuid [ref: > lessons.id, note: 'Used by the Continue button to resume study']
  enrolled_at timestamp [not null, default: `now()`]

  indexes {
    (user_id, course_id) [unique]
  }
}

Table lesson_progress {
  id uuid [pk, default: `uuid_generate_v4()`]
  enrolment_id uuid [not null, ref: > enrolments.id]
  lesson_id uuid [not null, ref: > lessons.id]
  is_completed boolean [not null, default: false]
  completed_at timestamp

  indexes {
    (enrolment_id, lesson_id) [unique]
  }
}

// ==========================================
// ASSIGNMENTS & ASSESSMENT
// ==========================================
Table assignments {
  id uuid [pk, default: `uuid_generate_v4()`]
  lesson_id uuid [not null, ref: > lessons.id]
  title varchar [not null]
  type assignment_type [not null]
  instructions text
  pass_score int [note: 'Min score required to pass a quiz']
  deadline timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp
}

Table submissions {
  id uuid [pk, default: `uuid_generate_v4()`]
  assignment_id uuid [not null, ref: > assignments.id]
  user_id uuid [not null, ref: > app_users.id]
  graded_by uuid [ref: > app_users.id, note: 'Instructor who graded']
  file_url varchar [note: 'URL of the submitted file']
  score decimal [note: 'Manual grading by instructor']
  feedback text
  submitted_at timestamp [not null, default: `now()`]
  graded_at timestamp
}

Table quiz_questions {
  id uuid [pk, default: `uuid_generate_v4()`]
  assignment_id uuid [not null, ref: > assignments.id]
  content text [not null]
  points int [not null, default: 1]
}

Table quiz_options {
  id uuid [pk, default: `uuid_generate_v4()`]
  question_id uuid [not null, ref: > quiz_questions.id]
  content text [not null]
  is_correct boolean [not null, default: false]
}

Table quiz_attempts {
  id uuid [pk, default: `uuid_generate_v4()`]
  assignment_id uuid [not null, ref: > assignments.id]
  user_id uuid [not null, ref: > app_users.id]
  total_score decimal [note: 'Auto-graded score']
  attempted_at timestamp [not null, default: `now()`]
}

// ==========================================
// INTERACTION & NOTIFICATIONS
// ==========================================
Table lesson_qna {
  id uuid [pk, default: `uuid_generate_v4()`]
  lesson_id uuid [not null, ref: > lessons.id]
  author_id uuid [not null, ref: > app_users.id]
  parent_id uuid [ref: > lesson_qna.id, note: 'null = question, set = reply']
  content text [not null]
  created_at timestamp [not null, default: `now()`]
}

Table reported_contents {
  id uuid [pk, default: `uuid_generate_v4()`]
  reporter_id uuid [not null, ref: > app_users.id]
  reported_entity_type varchar [not null, note: 'e.g., LESSON, QNA']
  reported_entity_id uuid [not null]
  resolved_by uuid [ref: > app_users.id, note: 'Admin/instructor who resolved']
  reason text [not null]
  status report_status [not null, default: 'PENDING']
  created_at timestamp [not null, default: `now()`]
  resolved_at timestamp
}

Table notifications {
  id uuid [pk, default: `uuid_generate_v4()`]
  user_id uuid [not null, ref: > app_users.id]
  type notification_type [not null]
  content text [not null]
  is_read boolean [not null, default: false]
  created_at timestamp [not null, default: `now()`]
}

// ==========================================
// LIVE PRACTICE (ADVANCED COMPONENT)
// ==========================================
Table live_sessions {
  id uuid [pk, default: `uuid_generate_v4()`]
  lesson_id uuid [not null, ref: > lessons.id]
  host_id uuid [not null, ref: > app_users.id, note: 'Instructor hosting the session']
  scheduled_time timestamp [not null]
  status session_status [not null, default: 'SCHEDULED']
  created_at timestamp [not null, default: `now()`]
}

Table breakout_rooms {
  id uuid [pk, default: `uuid_generate_v4()`]
  session_id uuid [not null, ref: > live_sessions.id]
  name varchar [not null]
  final_whiteboard_url varchar [note: 'Saved from Redis to MinIO/S3 after the session ends']
  created_at timestamp [not null, default: `now()`]
}

Table room_participants {
  id uuid [pk, default: `uuid_generate_v4()`]
  room_id uuid [not null, ref: > breakout_rooms.id]
  user_id uuid [not null, ref: > app_users.id]
  joined_at timestamp [not null, default: `now()`]
  left_at timestamp

  indexes {
    (room_id, user_id) [unique]
  }
}

Table room_messages {
  id uuid [pk, default: `uuid_generate_v4()`]
  room_id uuid [not null, ref: > breakout_rooms.id]
  sender_id uuid [not null, ref: > app_users.id]
  content text [not null]
  is_broadcast boolean [not null, default: false, note: 'Instructor message to all rooms']
  sent_at timestamp [not null, default: `now()`]
}

Table whiteboard_notes {
  id uuid [pk, default: `uuid_generate_v4()`]
  room_id uuid [not null, ref: > breakout_rooms.id]
  created_by uuid [not null, ref: > app_users.id]
  content text
  pos_x float [not null]
  pos_y float [not null]
  color varchar
  updated_at timestamp [not null, default: `now()`]
}

Table session_feedbacks {
  id uuid [pk, default: `uuid_generate_v4()`]
  session_id uuid [not null, ref: > live_sessions.id]
  learner_id uuid [not null, ref: > app_users.id]
  instructor_id uuid [not null, ref: > app_users.id, note: 'Instructor receiving the feedback']
  comment text
  rating int
  participation participation_level
  created_at timestamp [not null, default: `now()`]
}

Table forum_threads {
  id uuid [pk, default: `uuid_generate_v4()`]
  course_id uuid [not null, ref: > courses.id]
  author_id uuid [not null, ref: > app_users.id]
  title varchar [not null]
  content text [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp
}

Table forum_replies {
  id uuid [pk, default: `uuid_generate_v4()`]
  thread_id uuid [not null, ref: > forum_threads.id]
  author_id uuid [not null, ref: > app_users.id]
  content text [not null]
  created_at timestamp [not null, default: `now()`]
}
